{
  "version": 2,
  "buildCommand": "npm install && npm run build --workspace=client && npm run build --workspace=server",
  "outputDirectory": "client/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.js": {
      "runtime": "nodejs20.x",
      "includeFiles": "server/**"
    }
  }
}
