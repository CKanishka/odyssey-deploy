{
  "version": 2,
  "buildCommand": "npm install && npm run build && cd ../server && npm install && npm run build",
  "outputDirectory": "dist",
  "installCommand": "echo 'Skipping default install'",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.js": {
      "runtime": "nodejs20.x",
      "includeFiles": "server/**"
    }
  }
}
