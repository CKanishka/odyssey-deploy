{
  "version": 2,
  "buildCommand": "cd client && npm install && npm run build && cd ../server && npm install && npm run build",
  "outputDirectory": "client/dist",
  "installCommand": "echo 'Skipping default install'",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api"
    }
  ],
  "functions": {
    "api/index.js": {
      "runtime": "nodejs20.x",
      "includeFiles": "server/dist/**"
    }
  }
}
